{{!-- Architecture viewport: matrix rain + transformed stage of floor cards. --}}
{{#if canvas}}
  {{#if canvas.empty}}
  <div class="crns-canvas-empty">
    <i class="fas fa-network-wired"></i>
    <div class="crns-canvas-empty-hint">{{localize canvas.emptyHint}}</div>
    {{#if canvas.canAsk}}
    <button type="button" class="crns-icon-btn crns-ask-btn" data-action="runner-ask">
      <i class="fas fa-hand"></i> {{localize "CRNS.Runners.Ask"}}
    </button>
    {{/if}}
    {{#if canvas.asked}}
    <div class="crns-ask-sent">{{localize "CRNS.Runners.Asked"}}</div>
    {{/if}}
  </div>
  {{else}}
  <canvas class="crns-rain"></canvas>
  {{!-- The stage is a grid: one row per depth, one column per layout slot.
        Columns come out fractional (a floor above two children sits at 0.5), so
        every column is split in half and each card spans two half-columns —
        that puts a parent exactly over the gap between its children, which is
        where the connector wants it. --}}
  <div class="crns-stage crns-tree" style="--rows:{{canvas.rows}}; --tracks:{{canvas.tracks}}; --unit:{{canvas.unit}}">
    <svg class="crns-lines" preserveAspectRatio="none"></svg>

    {{#each canvas.floors as |floor|}}
    <div class="crns-floor-wrap{{#if floor.encrypted}} crns-wrap-fog{{/if}}"
         data-floor-index="{{floor.index}}"
         style="--row:{{floor.row}}; --col:{{floor.col}}">

      {{#if floor.encrypted}}
      {{!-- A sensed floor: the runner can tell it is there and nothing more.
            Standing at a fork he sees how many ways it goes, not what is down
            any of them. --}}
      <div class="crns-floor crns-fog-stub" data-floor-index="{{floor.index}}"
           title="{{localize "CRNS.Canvas.MoreFloors"}}">
        <div class="crns-fog-glitch">???</div>
        <div class="crns-fog-hint">{{floor.label}}</div>
        {{#if floor.showMoveHere}}
        <button type="button" class="crns-move-here crns-fog-move" data-action="floor-move-here"
                data-floor-index="{{floor.index}}" title="{{localize "CRNS.Canvas.Advance"}}">
          <i class="fas fa-arrow-down-to-line"></i> {{localize "CRNS.Canvas.Advance"}}
        </button>
        {{/if}}
      </div>
      {{else}}
      <div class="crns-floor{{#if floor.isRoot}} root{{/if}}{{#if floor.controlChip}} controlled{{/if}}" data-floor-index="{{floor.index}}"
           data-floor-id="{{floor.floorId}}"{{#if floor.controlColor}} style="--control-color:{{floor.controlColor}}"{{/if}}
           {{#if floor.description}}title="{{floor.description}}"{{/if}}>

        <div class="crns-floor-head">
          <span class="crns-floor-n">{{floor.number}}</span>
          <img class="crns-floor-glyph" src="{{floor.icon}}" alt="" />
          {{#if floor.isRoot}}<img class="crns-floor-root" src="{{floor.rootIcon}}" alt="" />{{/if}}
          <span class="crns-floor-title">{{floor.label}}</span>
          {{#if floor.showDv}}<span class="crns-floor-dv">{{localize "CRNS.Editor.DV"}} {{floor.dv}}</span>{{/if}}
          {{#if floor.gmGear}}
          <button type="button" class="crns-icon-btn crns-floor-gear" data-action="floor-gear" title="{{localize "CRNS.Canvas.GmFloor"}}"><i class="fas fa-gear"></i></button>
          {{/if}}
          {{#if floor.gmEdit}}
          <button type="button" class="crns-icon-btn crns-floor-open" data-action="floor-open" title="{{localize "CRNS.Canvas.OpenFloor"}}"><i class="fas fa-pen-to-square"></i></button>
          {{/if}}
        </div>
        {{!-- Shape editing: the ways into this floor and the buttons that grow
              the network. GM only, and only while the mode is on. --}}
        {{#if floor.shape}}
        <div class="crns-shape-box{{#if floor.shape.linking}} linking{{/if}}">
          <div class="crns-shape-ways">
            <span class="crns-shape-lbl">{{localize "CRNS.Shape.WaysIn"}}</span>
            {{#if floor.shape.isEntry}}
            <span class="crns-shape-entry">{{localize "CRNS.Shape.Entry"}}</span>
            {{/if}}
            {{#each floor.shape.entrances as |way|}}
            <span class="crns-shape-way{{#if way.primary}} primary{{/if}}">
              {{way.label}}
              <button type="button" class="crns-shape-x" data-action="shape-unlink"
                      data-from-id="{{way.id}}" title="{{localize "CRNS.Shape.Unlink"}}">
                <i class="fas fa-xmark"></i>
              </button>
            </span>
            {{/each}}
          </div>
          <div class="crns-shape-btns">
            <button type="button" class="crns-icon-btn" data-action="shape-add"
                    title="{{localize "CRNS.Shape.AddBelow"}}"><i class="fas fa-plus"></i></button>
            <button type="button" class="crns-icon-btn{{#if floor.shape.linking}} on{{/if}}"
                    data-action="shape-link" title="{{localize "CRNS.Shape.Link"}}"><i class="fas fa-link"></i></button>
            {{#if floor.shape.linkTarget}}
            <button type="button" class="crns-icon-btn accent" data-action="shape-link-to"
                    title="{{localize "CRNS.Shape.LinkHere"}}"><i class="fas fa-arrow-down-to-line"></i></button>
            {{/if}}
            <button type="button" class="crns-icon-btn danger" data-action="shape-remove"
                    title="{{localize "CRNS.Shape.Remove"}}"><i class="fas fa-trash"></i></button>
          </div>
        </div>
        {{/if}}
        {{!-- The lock badge sits on its own line. In the head it competed with
              the title for the same flex row, and the title lost — a floor
              called "Серверная" showed as two letters and an ellipsis. --}}
        {{#if floor.checkLabel}}
        <div class="crns-floor-gateline">
          <span class="crns-floor-gate" title="{{localize "CRNS.Canvas.OpenedBy"}}">
            <i class="fas fa-lock"></i>{{floor.checkLabel}}
          </span>
        </div>
        {{/if}}

        {{#if floor.contents}}
        <div class="crns-floor-contents" title="{{localize "CRNS.Canvas.FileContents"}}">
          <i class="fas fa-file-lines"></i><span>{{floor.contents}}</span>
        </div>
        {{/if}}

        {{!-- floor markers: breach / virus / control / eyedee (cloaks are arch-level) --}}
        <div class="crns-floor-markers">
          {{#if floor.markers.isPassword}}
          <span class="crns-fm crns-fm-lock{{#if floor.markers.breached}} breached{{/if}}" title="{{floor.markers.lockTitle}}">
            <i class="fas {{#if floor.markers.breached}}fa-lock-open{{else}}fa-lock{{/if}}"></i>
          </span>
          {{/if}}
          {{#each floor.markers.viruses as |vr|}}
          <span class="crns-fm crns-fm-virus" title="{{vr.title}}"{{#if vr.gm}} data-action="fx-clear-marker" data-floor-id="{{../floor.floorId}}" data-kind="virus" data-id="{{vr.id}}"{{/if}}>
            <i class="fas fa-virus"></i>{{#if vr.gm}}<i class="fas fa-xmark crns-fm-x"></i>{{/if}}
          </span>
          {{/each}}
          {{#if floor.markers.control}}
          <span class="crns-fm crns-fm-control" style="--control-color:{{floor.markers.control.color}}" title="{{floor.markers.control.title}}"{{#if floor.markers.control.gm}} data-action="fx-clear-control" data-floor-id="{{floor.floorId}}"{{/if}}>
            <i class="fas fa-tower-cell"></i> {{floor.markers.control.name}}
          </span>
          {{/if}}
          {{#if floor.markers.eyedeeAccessed}}
          <span class="crns-fm crns-fm-eyedee" title="{{localize "CRNS.Canvas.Accessed"}}"><i class="fas fa-folder-open"></i></span>
          {{/if}}
          {{#each floor.markers.eyedee as |ed|}}
          <span class="crns-fm crns-fm-accessor" title="{{ed.title}}"{{#if ed.gm}} data-action="fx-clear-eyedee" data-floor-id="{{../floor.floorId}}" data-pid="{{ed.pid}}"{{/if}}>
            <img src="{{ed.img}}" alt="{{ed.name}}" />{{#if ed.gm}}<i class="fas fa-xmark crns-fm-x"></i>{{/if}}
          </span>
          {{/each}}
        </div>

        {{#if floor.gmGear}}
        <div class="crns-floor-gearpop">
          {{#if floor.isPassword}}
          <button type="button" class="crns-mini" data-action="fx-toggle-breach" data-floor-id="{{floor.floorId}}" data-value="{{#if floor.markers.breached}}false{{else}}true{{/if}}">
            <i class="fas fa-lock-open"></i> {{localize "CRNS.Canvas.ToggleBreach"}}
          </button>
          {{/if}}
          {{#if floor.isControlNode}}
          {{#if floor.controlChip}}
          <button type="button" class="crns-mini" data-action="fx-clear-control" data-floor-id="{{floor.floorId}}">
            <i class="fas fa-xmark"></i> {{localize "CRNS.Canvas.ClearControl"}}
          </button>
          {{/if}}
          <select class="crns-fx-control-sel" data-action="fx-set-control" data-floor-id="{{floor.floorId}}">
            <option value="">{{localize "CRNS.Canvas.SetControl"}}…</option>
            {{#each floor.runnersForControl as |r|}}
            <option value="{{r.pid}}">{{r.name}}</option>
            {{/each}}
          </select>
          {{/if}}
        </div>
        {{/if}}

        {{#if floor.entities.length}}
        <div class="crns-floor-chips">
          {{#each floor.entities as |ent|}}
          {{> "modules/cpr-netrunning/templates/entity-card.hbs" ent=ent}}
          {{/each}}
        </div>
        {{/if}}

        {{#if floor.participants.length}}
        <div class="crns-floor-runners">
          {{#each floor.participants as |p|}}
          <div class="crns-runner-slot">
            <div class="crns-runner-chip{{#if p.isMine}} mine{{/if}}{{#if p.selected}} selected{{/if}}"
                 data-entity-ref="{{p.ref}}" data-pid="{{p.pid}}"
                 {{#if p.gmDraggable}}draggable="true"{{/if}}
                 style="--runner-color:{{p.color}}" title="{{p.name}}">
              <img src="{{p.img}}" alt="{{p.name}}" />
              <span class="crns-runner-name">{{p.name}}</span>
            </div>
            {{#if p.progMinis.length}}
            <div class="crns-prog-minis">
              {{#each p.progMinis as |mp|}}
              <span class="crns-prog-mini crns-prog-{{mp.cls}}{{#if mp.derezzed}} derezzed{{/if}}{{#if mp.selected}} selected{{/if}}{{#if mp.selectable}} selectable{{/if}}"
                    data-entity-ref="{{mp.ref}}" title="{{mp.name}}">
                <span class="crns-prog-mini-code">{{mp.code}}</span>
                <i class="fas {{mp.icon}}"></i>
                {{#if mp.hasRez}}<span class="crns-prog-mini-rez">{{mp.rez}}</span>{{/if}}
                {{#if mp.targets.length}}
                <span class="crns-prog-mini-targets">
                  {{#each mp.targets as |tg|}}<i class="fas fa-crosshairs" style="color:{{tg.color}}" title="{{tg.name}}"></i>{{/each}}
                </span>
                {{/if}}
              </span>
              {{/each}}
            </div>
            {{/if}}
          </div>
          {{/each}}
        </div>
        {{/if}}

        {{#if floor.showMoveHere}}
        <button type="button" class="crns-move-here" data-action="floor-move-here" data-floor-index="{{floor.index}}">
          <i class="fas fa-arrow-down-to-line"></i> {{localize "CRNS.Canvas.MoveHere"}}
        </button>
        {{/if}}
      </div>

      {{/if}}
    </div>
    {{/each}}
  </div>

  {{!-- Arch-level cloak strip (Addendum 6): fixed overlay at the top of the
        viewport (not pan/zoomed). GM sees all cloaks + can ✕; a player sees only
        their own. --}}
  {{#if canvas.hasCloaks}}
  <div class="crns-cloak-strip" aria-label="{{localize "CRNS.Chat.Cloak"}}">
    {{#each canvas.cloakStrip as |ck|}}
    <span class="crns-cloak-mark" title="{{ck.title}}"{{#if ck.gm}} data-action="fx-clear-cloak" data-cloak-id="{{ck.id}}"{{/if}}>
      <i class="fas fa-user-ninja"></i><span class="crns-cloak-n">{{ck.n}}</span>{{#if ck.gm}}<i class="fas fa-xmark crns-cloak-x"></i>{{/if}}
    </span>
    {{/each}}
  </div>
  {{/if}}

  {{#if canvas.canEditShape}}
  <div class="crns-shape-overlay">
    <button type="button" class="crns-icon-btn{{#if canvas.shapeEdit}} on{{/if}}"
            data-action="shape-toggle" title="{{localize "CRNS.Shape.Toggle"}}">
      <i class="fas fa-diagram-project"></i> {{localize "CRNS.Shape.Toggle"}}
    </button>
    {{#if canvas.linking}}
    <span class="crns-shape-hint">{{localize "CRNS.Shape.PickTarget"}}
      <button type="button" class="crns-icon-btn" data-action="shape-link-cancel"><i class="fas fa-xmark"></i></button>
    </span>
    {{/if}}
  </div>
  {{/if}}

  <div class="crns-zoom-overlay">
    <button type="button" class="crns-icon-btn" data-action="cam-zoom-in" title="{{localize "CRNS.Canvas.ZoomIn"}}"><i class="fas fa-plus"></i></button>
    <button type="button" class="crns-icon-btn" data-action="cam-zoom-out" title="{{localize "CRNS.Canvas.ZoomOut"}}"><i class="fas fa-minus"></i></button>
    <button type="button" class="crns-icon-btn" data-action="cam-reset" title="{{localize "CRNS.Canvas.ZoomReset"}}"><i class="fas fa-crosshairs"></i></button>
  </div>
  {{/if}}
{{/if}}
