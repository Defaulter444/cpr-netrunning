{{!-- Architecture editor (floor chain). GM draft editing. --}}
{{#if editor}}
<div class="crns-editor-body" data-arch-id="{{editor.archId}}">

  <div class="crns-editor-head">
    <input type="text" class="crns-editor-name" data-action="editor-name" value="{{editor.name}}" />
    <div class="crns-editor-meta">
      <span class="crns-editor-count">{{localize "CRNS.Editor.Floors"}}: {{editor.floorCount}}</span>
      <span class="crns-editor-demons{{#if editor.demonBudgetFull}} full{{/if}}">{{localize "CRNS.Editor.Demons"}} {{editor.demons}}/{{editor.demonMax}}</span>
    </div>
    <div class="crns-editor-actions">
      <button type="button" class="crns-btn crns-editor-savebtn{{#if editor.dirty}} dirty{{/if}}" data-action="editor-save">
        {{#if editor.dirty}}<span class="crns-dirty-dot"></span>{{/if}}<i class="fas fa-floppy-disk"></i> {{localize "CRNS.Editor.Save"}}
      </button>
      <button type="button" class="crns-btn" data-action="editor-cancel"><i class="fas fa-xmark"></i> {{localize "CRNS.Editor.Cancel"}}</button>
    </div>
  </div>

  <div class="crns-floor-chain">
    {{#each editor.floors as |floor|}}
    <div class="crns-floor-card{{#if floor.focused}} focused{{/if}}" data-floor-id="{{floor.id}}">

      <div class="crns-floor-top">
        <span class="crns-floor-num">{{floor.number}}</span>
        <img class="crns-floor-icon" src="{{floor.kindIcon}}" alt="" />
        <select class="crns-floor-kind" data-action="floor-kind">
          {{#each ../editor.kinds as |k|}}
          <option value="{{k.id}}"{{#if (crnsEq k.id floor.kind)}} selected{{/if}}>{{k.label}}</option>
          {{/each}}
        </select>
        {{!-- Any floor may be named, not only a "custom" one. A control node is
              a thing in the fiction — "лифты", "камеры", "шлюз" — and the runner
              holding three of them needs to know which is which. Empty falls
              back to the kind's own name. --}}
        <input type="text" class="crns-floor-label" data-action="floor-label"
               placeholder="{{localize "CRNS.Editor.LabelPlaceholder"}}" value="{{floor.label}}" />
        <label class="crns-floor-dv">{{localize "CRNS.Editor.DV"}} <input type="number" min="0" data-action="floor-dv" value="{{floor.dv}}" /></label>
        <label class="crns-floor-check" title="{{localize "CRNS.Editor.Check"}}">
          <select data-action="floor-check">
            {{#each floor.checkChoices as |c|}}
            <option value="{{c.id}}"{{#if (crnsEq c.id floor.check)}} selected{{/if}}>{{c.label}}</option>
            {{/each}}
          </select>
        </label>
        <span class="crns-floor-ctrls">
          <button type="button" class="crns-icon-btn" data-action="floor-up" title="{{localize "CRNS.Editor.MoveUp"}}"{{#if floor.isFirst}} disabled{{/if}}><i class="fas fa-arrow-up"></i></button>
          <button type="button" class="crns-icon-btn" data-action="floor-down" title="{{localize "CRNS.Editor.MoveDown"}}"{{#if floor.isLast}} disabled{{/if}}><i class="fas fa-arrow-down"></i></button>
          <button type="button" class="crns-icon-btn" data-action="floor-insert" title="{{localize "CRNS.Editor.AddBelow"}}"><i class="fas fa-plus"></i></button>
          <button type="button" class="crns-icon-btn" data-action="floor-delete" title="{{localize "CRNS.Editor.DeleteFloor"}}"{{#unless floor.canDelete}} disabled{{/unless}}><i class="fas fa-trash"></i></button>
        </span>
      </div>

      {{!-- Where this floor hangs. This one control is what turns the old
            straight chain into a tree: pick a parent and the floor moves under
            it, pick the same parent for two floors and the architecture forks
            there. --}}
      <div class="crns-floor-tree">
        <label class="crns-floor-parent">
          <span class="crns-floor-parent-lbl">{{localize "CRNS.Editor.Parent"}}</span>
          <select data-action="floor-parent">
            {{#each floor.parentChoices as |pc|}}
            <option value="{{pc.id}}"{{#if (crnsEq pc.id floor.parent)}} selected{{/if}}>{{pc.label}}</option>
            {{/each}}
          </select>
        </label>
        {{#if floor.mergeChoices}}
        <label class="crns-floor-image-edit" title="{{localize "CRNS.Editor.ImageHint"}}">
          <span class="crns-floor-parent-lbl">{{localize "CRNS.Editor.Image"}}</span>
          <input type="text" data-action="floor-image" value="{{floor.contentsImage}}"
                 placeholder="{{localize "CRNS.Editor.ImagePlaceholder"}}" />
          <button type="button" class="crns-icon-btn" data-action="floor-image-pick"
                  title="{{localize "CRNS.Editor.ImagePick"}}"><i class="fas fa-image"></i></button>
        </label>
        <label class="crns-floor-contents-edit" title="{{localize "CRNS.Editor.ContentsHint"}}">
          <span class="crns-floor-parent-lbl">{{localize "CRNS.Editor.Contents"}}</span>
          <textarea data-action="floor-contents" rows="2"
                    placeholder="{{localize "CRNS.Editor.ContentsPlaceholder"}}">{{floor.contents}}</textarea>
        </label>
        <label class="crns-floor-merge" title="{{localize "CRNS.Editor.MergeHint"}}">
          <span class="crns-floor-parent-lbl">{{localize "CRNS.Editor.Merge"}}</span>
          <select data-action="floor-merge" multiple size="3">
            {{#each floor.mergeChoices as |mc|}}
            <option value="{{mc.id}}"{{#if mc.on}} selected{{/if}}>{{mc.label}}</option>
            {{/each}}
          </select>
        </label>
        {{/if}}
        <label class="crns-floor-gate" title="{{localize "CRNS.Editor.GateHint"}}">
          <input type="checkbox" data-action="floor-gate"{{#if floor.gate}} checked{{/if}}{{#if floor.gateForced}} disabled{{/if}} />
          <i class="fas fa-lock"></i> {{localize "CRNS.Editor.Gate"}}
        </label>
        <span class="crns-floor-depth" title="{{localize "CRNS.Editor.Branch"}}">
          <i class="fas fa-layer-group"></i> {{floor.depth}}
        </span>
        {{#if floor.forks}}
        <span class="crns-floor-forks"><i class="fas fa-code-branch"></i> {{localize "CRNS.Canvas.Forks" n=floor.forks}}</span>
        {{/if}}
      </div>

      <textarea class="crns-floor-desc" data-action="floor-desc" rows="2" placeholder="{{localize "CRNS.Editor.DescPlaceholder"}}">{{floor.description}}</textarea>

      <div class="crns-floor-entities">
        <div class="crns-ice-row">
          <span class="crns-ent-label">{{localize "CRNS.Editor.Ice"}}</span>
          {{#each floor.iceSlots as |slot|}}
            {{#if slot.filled}}
            <div class="crns-ice-slot filled" data-ice-id="{{slot.uid}}">
              <img src="{{slot.img}}" alt="{{slot.name}}" />
              <span class="crns-ent-name">{{slot.name}}</span>
              <button type="button" class="crns-icon-btn crns-ent-remove" data-action="ice-remove" title="{{localize "CRNS.Editor.Remove"}}"><i class="fas fa-times"></i></button>
            </div>
            {{else}}
            <button type="button" class="crns-ice-slot empty" data-action="ice-add"><i class="fas fa-plus"></i> {{localize "CRNS.Editor.AddIce"}}</button>
            {{/if}}
          {{/each}}
        </div>

        <div class="crns-demon-row">
          <span class="crns-ent-label">{{localize "CRNS.Editor.Demon"}}</span>
          {{#if floor.demon}}
          <div class="crns-demon-slot filled">
            <img src="{{floor.demon.img}}" alt="{{floor.demon.name}}" />
            <span class="crns-ent-name">{{floor.demon.name}}</span>
            <button type="button" class="crns-icon-btn crns-ent-remove" data-action="demon-remove" title="{{localize "CRNS.Editor.Remove"}}"><i class="fas fa-times"></i></button>
          </div>
          {{else}}
          <button type="button" class="crns-demon-slot empty" data-action="demon-add"{{#if ../editor.demonBudgetFull}} disabled title="{{localize "CRNS.Editor.DemonBudgetFull"}}"{{/if}}><i class="fas fa-plus"></i> {{localize "CRNS.Editor.AddDemon"}}</button>
          {{/if}}
        </div>
      </div>

    </div>
    {{/each}}
  </div>

</div>
{{/if}}
