<section class="ap-scanner-body">
  <div class="ap-top {{#if hasRollCard}}ap-top-with-roll{{/if}}">
    <div class="ap-top-left">
  <header class="ap-header"><strong><i class="fas fa-map-location-dot" aria-hidden="true"></i> {{sceneName}}</strong><label class="ap-scene-color">Цвет точек без архитектуры<input type="color" name="unassignedColor" value="{{unassignedColor}}" title="Цвет точек без привязки к архитектуре"></label>{{#if hasResult}}<span class="ap-result">Сканер: {{result}}</span>{{/if}}<button type="button" class="ap-hide-all" data-action="hide-all" title="Скрыть все точки сцены, их названия и остановить сигналы"><i class="fas fa-eye-slash" aria-hidden="true"></i> Скрыть все точки</button></header>
    <div class="ap-top-controls">
      <div class="ap-controls-heading"><h3 class="ap-section-title"><i class="fas fa-tower-broadcast" aria-hidden="true"></i> Управление обнаружением</h3></div>
      <div class="ap-runner-row"><label class="ap-runner-field">Токен нетраннера<select name="runner"><option value="">Выберите нетраннера…</option>{{#each runners}}<option value="{{id}}" {{#if selected}}selected{{/if}}>{{name}}</option>{{/each}}</select></label>
      <button type="button" data-action="locate-runner" {{#if runnerMissing}}disabled{{/if}}><i class="fas fa-crosshairs"></i> Найти нетраннера</button><label class="ap-player-owned"><input type="checkbox" name="playerOwnedOnly" {{#if playerOwnedOnly}}checked{{/if}}> только персонажи игроков</label></div>
      <label class="ap-radius-field"><span>Расстояние от нетраннера ({{units}}). <small>0 — показать все точки</small></span><input type="number" name="radius" value="{{radius}}" min="0" step="any"></label>
    </div>
    </div>
    {{#if hasRollCard}}<section class="ap-roll-preview" aria-label="Бросок «Сканера»"><div class="ap-roll-card chat-log" aria-live="polite">Загрузка броска…</div></section>{{/if}}
  </div>
  <div class="ap-discovery-title"><h3 class="ap-section-title"><i class="fas fa-network-wired" aria-hidden="true"></i> Точки доступа</h3><span class="ap-selection-count">Выбрано: {{selectedCount}}</span></div>
  <div class="ap-list-header" aria-label="Столбцы точек доступа"><table class="ap-control-table {{#unless showRevealAll}}ap-hide-reveal-all{{/unless}}"><colgroup><col class="ap-col-select"><col class="ap-col-name"><col class="ap-col-net"><col class="ap-col-distance"><col>{{#each bulkControls}}<col class="ap-col-toggle">{{/each}}</colgroup><thead><tr><th aria-label="Выбрать"></th><th>Точка доступа</th><th>Архитектура</th><th>Расстояние<br>({{units}})</th><th>Видят</th><th class="ap-toggle">Показать:<br><span class="ap-dynamic-name" title="{{runnerName}}">{{runnerName}}</span></th>{{#if showRevealAll}}<th class="ap-toggle">Показать<br>всем</th>{{/if}}<th class="ap-toggle">Импульсы: <span class="ap-dynamic-label">{{pulseCount}}</span> {{pulseUnit}}</th><th class="ap-toggle">Повторять<br>сигнал</th><th class="ap-toggle">Показать<br>название</th></tr></thead></table></div>
  <div class="ap-list">
    <table class="ap-control-table {{#unless showRevealAll}}ap-hide-reveal-all{{/unless}}"><colgroup><col class="ap-col-select"><col class="ap-col-name"><col class="ap-col-net"><col class="ap-col-distance"><col>{{#each bulkControls}}<col class="ap-col-toggle">{{/each}}</colgroup>

      <tbody>{{#each rows}}<tr {{#unless visible}}hidden{{/unless}}>
        <td><input type="checkbox" data-ap-select="{{id}}" aria-label="Выбрать {{name}}" {{#if selected}}checked{{/if}}></td>
        <td><div class="ap-name-edit"><button type="button" class="ap-icon-button" data-action="edit" data-ap-id="{{id}}" title="Изменить {{name}}" aria-label="Изменить {{name}}"><i class="fas fa-pen-to-square"></i></button><button type="button" class="ap-name-button" data-action="locate" data-ap-id="{{id}}" title="Найти на сцене">{{name}}</button></div><small>{{type}}</small></td>
        <td><span class="ap-swatch" style="background-color: {{color}}"></span>{{netarch}}</td>
        <td class="ap-distance">{{distanceText}}</td><td title="{{statusTitle}}">{{status}}</td>
        {{#each controls}}<td class="ap-toggle"><input type="checkbox" data-control="{{key}}" data-group="{{group}}" data-ap-id="{{apId}}" aria-label="{{label}}: {{name}}" {{#if checked}}checked{{/if}}></td>{{/each}}
      </tr>{{/each}}</tbody>
    </table>
    {{#unless hasRows}}<p class="ap-empty">Перетащите шаблон из папки актёров «Точки доступа — Нетраннинг» на сцену. Двойной щелчок по точке открывает её настройки.</p>{{/unless}}
  </div>
  <footer class="ap-bulk-bar" aria-label="Управление выбранными точками">
    <table class="ap-control-table {{#unless showRevealAll}}ap-hide-reveal-all{{/unless}}"><colgroup><col class="ap-col-select"><col class="ap-col-name"><col class="ap-col-net"><col class="ap-col-distance"><col>{{#each bulkControls}}<col class="ap-col-toggle">{{/each}}</colgroup>
      <tbody><tr><td colspan="2" class="ap-footer-selection"><div class="ap-selection-tools"><button type="button" data-action="select-visible">Выбрать видимые</button><button type="button" data-action="clear">Снять выделение</button></div></td><td colspan="2" class="ap-bulk-label"><strong>Для выбранных</strong></td><td class="ap-bulk-apply"><button type="button" data-action="apply" {{#unless canApply}}disabled{{/unless}}>Изменить</button></td>
        {{#each bulkControls}}<td class="ap-toggle"><input type="checkbox" data-control="{{key}}" data-group="{{group}}" title="{{label}} для выбранных точек" aria-label="{{label}} для выбранных точек" {{#if checked}}checked{{/if}}></td>{{/each}}
      </tr></tbody>
    </table>
  </footer>
  <p class="notes">Показано {{visibleCount}} из {{totalCount}} точек. Переключатели в строках действуют сразу. Нижняя строка меняет только отмеченные вами параметры выбранных точек. Черта означает разные значения.</p>
  <p class="notes">Сигнал видят только игроки, которым открыта точка. Обнаружение не требуется для подключения к архитектуре.</p>
</section>
